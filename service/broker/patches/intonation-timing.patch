 @dataclass
 class Analysis:
@@ -140,6 +157,44 @@ class Analysis:
                   "cents": round(n.cents, 1), "status": n.status} for n in m),
                 key=lambda d: abs(d["cents"]), default=None,
             ),
+            "timing": self.timing(),
+        }
+
+    def timing(self) -> dict:
+        """Onset error per note, relative to the recording's OWN average tempo.
+
+        What this measures: whether the notes landed where this performance's own pulse
+        says they should. `score_onset_s` is the note's position on a metronome at
+        `implied_tempo_bpm`, so a take that is uniformly slower shows near-zero error here
+        and a tempo away from the score's instead -- deliberately, because "played the
+        whole thing at 92 BPM" and "rushed bar 3" are different faults and this block is
+        only the second one.
+
+        What it does not measure: rhythm. The onsets come from a DTW path over a *pitch*
+        track, so a repeated note has no boundary to find and a soft attack has nothing to
+        detect; a duration is only as good as that path. It also says nothing about the
+        right tempo, which is the separate question above it.
+        """
+        rows = [n for n in self.notes
+                if n.score_onset_s is not None and n.status != "misaligned"]
+        if not rows:
+            return {"notes_measured": 0, "threshold_ms": TIMING_THRESHOLD_MS}
+        errors = {n.index: n.onset_error_ms for n in rows}
+        ordered = sorted(abs(errors[n.index]) for n in rows)
+        beyond = [n for n in rows if abs(errors[n.index]) > TIMING_THRESHOLD_MS]
+        worst = max(rows, key=lambda n: abs(errors[n.index]))
+        return {
+            "notes_measured": len(rows),
+            "threshold_ms": TIMING_THRESHOLD_MS,
+            "median_abs_ms": round(float(np.median(ordered)), 1),
+            "p90_abs_ms": round(float(np.percentile(ordered, 90)), 1),
+            "max_abs_ms": round(ordered[-1], 1),
+            # signed, so a whole take that drags reads as positive rather than as noise
+            "mean_signed_ms": round(float(np.mean([errors[n.index] for n in rows])), 1),
+            "notes_beyond": len(beyond),
+            "worst": {"index": worst.index, "note": worst.written_name,
+                      "measure": worst.measure,
+                      "error_ms": round(errors[worst.index], 1)},
         }
 
 
