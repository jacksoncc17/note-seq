+    check("the straight-tempo fixture lands on its own pulse",
+          t["median_abs_ms"] < 50.0, f"median {t['median_abs_ms']} ms (one frame is 23)")
+    check("nothing on the fixture is outside the timing threshold",
+          t["notes_beyond"] == 0, f"{t['notes_beyond']} of {t['notes_measured']}")
+    check("every measured note reports an onset error",
+          all(n.onset_error_ms is not None for n in straight.measured))
+
+    # The real take is not straight-tempo, and that is what this block reports: drift away
+    # from the take's own average pulse. If it came out near zero on a rubato performance,
+    # the measurement would be showing nothing.
+    real_t = analysis.summary()["timing"]
+    check("a rubato take shows drift against its own average pulse",
