+    @property
+    def onset_error_ms(self) -> float | None:
+        """How late (positive) or early (negative) this note landed, in milliseconds.
+
+        Measured against `score_onset_s`, which is the note's position on a metronome at
+        the tempo the *recording* implies on average -- see `Analysis.timing` for what
+        that does and does not mean.
+        """
+        if self.score_onset_s is None:
+            return None
+        return (self.onset_s - self.score_onset_s) * 1000.0
