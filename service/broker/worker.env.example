# Copy this to `worker.env` beside it and fill it in:
#
#   cp service/broker/worker.env.example service/broker/worker.env
#   chmod 600 service/broker/worker.env
#
# `run_worker.sh` sources that file if it exists, so a restart is one command and no
# secret has to be retyped -- or end up in your shell history, or in the output of `ps`.
# Anything already set in the environment wins, so a one-off override still works.
#
# `worker.env` is not committed (service/.gitignore), and it should stay that way: the
# worker key is the broker's, and the token is a capability to publish pieces to your page.

# ------------------------------------------------------------------ the broker
# The broker's API root, with /api/v1 on the end.
BROKER_URL=https://example.com/api/v1

# The key from `POST /api/v1/admin/workers/` with {"name": "lan-note-seq"}. Shown once;
# re-registering the same name rotates it.
WORKER_KEY=replace-me

# What this worker is called in the broker's admin view. One worker runs one service.
WORKER_NAME=lan-note-seq

# ------------------------------------------------------------------ the page
# Where the "open the page" link on a finished job points, and -- unless
# SERVICE_PUBLISH_URL says otherwise -- where the finished piece is sent.
NOTE_SEQ_VIEWER_URL=https://example.com/note-seq

# Optional: set only to send pieces somewhere other than the link above. It is a *service
# root*, the same value as NOTE_SEQ_VIEWER_URL, not the API path.
# SERVICE_PUBLISH_URL=https://example.com/note-seq

# Required for pieces to arrive at all, and it must be the page's own
# SERVICE_UPLOAD_TOKEN (NOTE_SEQ_UPLOAD_TOKEN in the broker's .env). Without it the send
# fails with 401 and the piece waits in data/outbox/ instead of appearing on the page --
# which is safe, and visible as `outbox: N` in /api/v1/status, but not what you wanted.
SERVICE_PUBLISH_TOKEN=replace-me
