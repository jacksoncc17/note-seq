# Settings for the Garage Web UI. Copy to ~/.config/garage-webui/env, fill in, chmod 600.
#
# The UI reads `admin.admin_token` from CONFIG_PATH when it can; API_ADMIN_KEY is the explicit
# fallback, and there is no harm in setting both.
CONFIG_PATH=/home/YOU/.config/garage/garage.toml
PORT=3909
# 127.0.0.1: bind to loopback and reach it through an SSH tunnel if you would rather it were
# not on the LAN at all:  ssh -L 3909:127.0.0.1:3909 you@host
HOST=0.0.0.0
API_BASE_URL=http://127.0.0.1:3903
API_ADMIN_KEY=the admin.admin_token from garage.toml
S3_ENDPOINT_URL=http://127.0.0.1:3900
S3_REGION=garage
# Requires a bcrypt hash:  htpasswd -nbBC 10 user 'password'  (or python -c with bcrypt).
# Keep it out of a shell heredoc: "$2b$10$…" is eaten by expansion, and the UI then starts
# without a login and answers every request.
AUTH_USER_PASS=user:$2b$10$...
