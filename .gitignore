# Virtualenv (720 MB, and reproducible from setup.py)
.venv/
venv/

# Python build artifacts
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime artifacts: derived question banks, rendered MIDI, synthesized audio,
# session logs, microphone recordings. All regenerable -- see
# memorization/README.md and tutor/README.md.
memorization/output/
tutor/output/

# TLS material for the tablet client, generated by `tutor --make-cert`.
# A private key must never enter history, and the certificates are
# machine-specific anyway.
tutor/certs/

# Editor leftovers
*.swp
*.swo
*~

# analyzer: downloaded audio and derived maps are local artifacts
analyzer/cache/
analyzer/output/

# analyzer: scratch space while a module is being developed
analyzer/.scratch/

# service: what it produces and its scratch space are ignored in service/.gitignore.
# This one is for a scratch directory at the top level -- staged build output, and a
# docker config redirected here because the sandboxed home directory is read-only.
.scratch/

# A 100 MB clone of a scoring library, used as a reference while building the follower.
# It is not part of this project and must not be committed to it.
cyolo_score_following/

# Caches written by tools run in this tree.
.npm-cache/
.fontcache/
