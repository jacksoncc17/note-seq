# Virtualenv (720 MB, and reproducible from setup.py)
.venv/
venv/

# Python build artifacts
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/

# The desktop halves of the project: `analyzer/` (alignment, engraving, the local
# follower), `memorization/` (the practice app, whose `analyze.py` builds the reference
# MIDI) and `tutor/` (the tablet client). They are *not* tracked in this branch, which
# carries the web service in `service/`; the directories are still on the machine this
# was developed on, and every earlier commit still has them, so
#
#   git checkout <commit> -- analyzer memorization tutor
#
# brings a copy back into a clone. Note what a clone without them cannot do: the
# service's own pipeline (`memorization/analyze.py`, the analyzer's `align`, `measures`,
# `scoreview`) and its pipeline tests need them, and so do the memorization and tutor
# apps. Serving a finished piece never does -- see service/README.md, and
# `test_serving_a_piece_needs_no_analyzer`, which is the test that holds that line.
analyzer/
memorization/
tutor/

# Editor leftovers
*.swp
*.swo
*~

# service: what it produces and its scratch space are ignored in service/.gitignore.
# This one is for a scratch directory at the top level -- staged build output, and a
# docker config redirected here because the sandboxed home directory is read-only.
.scratch/

# A 100 MB clone of a third-party scoring library (Henkel & Widmer, MIT), kept beside
# this work as a reference and never imported by it: `analyzer/tools/cyolo_eval.py` takes
# its path as an argument. Not this project's code, so it is not published with it.
cyolo_score_following/

# Caches written by tools run in this tree.
.npm-cache/
.fontcache/

# Local notes and shell transcripts. This one held a broker password and a live worker key
# when it was first noticed, which is the whole reason it is not tracked -- and the reason
# to keep tokens in `service/broker/worker.env` (ignored too) rather than in commands that
# get pasted into a scratch file.
useful_commands.txt
